{
  "version": 2,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo-sitemap"
    },
    {
      "source": "/policies/shipping-policy",
      "destination": "/api/seo-shipping-policy"
    },
    {
      "source": "/policies/return-policy",
      "destination": "/api/seo-return-policy"
    },
    {
      "source": "/google-products.xml",
      "destination": "/api/merchant-feed"
    },
    {
      "source": "/materials",
      "destination": "/api/seo-catalogue"
    },
    {
      "source": "/products/:id/:slug",
      "destination": "/api/seo-product?id=:id"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/handler?route=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/search",
      "destination": "/#catalogue",
      "permanent": true
    },
    {
      "source": "/policies/contact-information",
      "destination": "/#visit",
      "permanent": true
    },
    {
      "source": "/pages/track-your-order",
      "destination": "https://www.purelyjid.in/track-order",
      "permanent": true
    },
    {
      "source": "/collections/all",
      "destination": "/materials",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sheet-sync",
      "schedule": "0 3 * * *"
    }
  ]
}
