{
  "version": 2,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/handler?route=seo-sitemap"
    },
    {
      "source": "/materials",
      "destination": "/api/handler?route=seo-catalogue"
    },
    {
      "source": "/products/:id/:slug",
      "destination": "/api/handler?route=seo-product&id=:id"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/handler?route=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
